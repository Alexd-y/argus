<section class="valhalla-remediation panel" id="remediation-priority">
    <h2>Recommendations and Prioritization</h2>
    <h3>Vulnerability Remediation Stages</h3>
    <div class="ai-slot-body">
        {% set st = ai_sections.get("remediation_stages") if ai_sections is defined else "" %}
        {% if st and st.strip() %}
            {{ st | md | safe }}
        {% else %}
            <p>Use stack-neutral controls until the technology stack is verified: application middleware, reverse proxy or WAF rules, identity provider settings, monitoring, and repeatable validation evidence.</p>
        {% endif %}
    </div>

    <h3>Remediation Matrix</h3>
    {% set rem_matrix = remediation_matrix if remediation_matrix is defined else [] %}
    {% if rem_matrix %}
    <table>
        <thead>
            <tr>
                <th>Finding ID</th>
                <th>Title</th>
                <th>Severity</th>
                <th>CVSS</th>
                <th>Priority</th>
                <th>Deadline</th>
                <th>Effort</th>
                <th>Est. Hours</th>
                <th>Affected Layer</th>
                <th>Owner Team</th>
                <th>Component</th>
                <th>Fix Action</th>
                <th>Rollback Risk</th>
                <th>Verification</th>
                <th>Test Case</th>
                <th>Acceptance Criteria</th>
                <th>Dependencies</th>
                <th>Business Impact</th>
            </tr>
        </thead>
        <tbody>
            {% for entry in rem_matrix %}
            <tr>
                <td><code>{{ entry.finding_id | default(entry.id or "") | e }}</code></td>
                <td>{{ entry.title | e }}</td>
                <td>{{ entry.severity | e }}</td>
                <td>{{ entry.cvss_score | default(entry.cvss or "") | e }}</td>
                <td>{{ entry.priority | e }}</td>
                <td>{{ entry.deadline | e }}</td>
                <td>{{ entry.effort | e }}</td>
                <td>{{ entry.estimated_hours | default("—") | e }}</td>
                <td>{{ entry.affected_layer | e }}</td>
                <td>{{ entry.owner_team | default(entry.owner or "") | e }}</td>
                <td>{{ entry.config_component | default(entry.component or "") | e }}</td>
                <td>{{ entry.fix_action | default(entry.fix or "") | e }}</td>
                <td>{{ entry.rollback_risk | e }}</td>
                <td>{{ entry.verification_step | default(entry.verification or "") | e }}</td>
                <td>{{ entry.test_case | default("—") | e }}</td>
                <td>{{ entry.acceptance_criteria | e }}</td>
                <td>{{ entry.dependencies | default("—") | e }}</td>
                <td>{{ entry.business_impact | default("—") | e }}</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
    {% else %}
    <p>No remediation matrix available. Refer to findings table for remediation guidance.</p>
    {% endif %}

    <h3>Tier 1 — Immediate (P0)</h3>
    {% set tier1 = remediation_stages.get("tier_1_immediate", []) if remediation_stages is defined else [] %}
    {% if tier1 %}
    <table>
        <thead>
            <tr>
                <th>Finding ID</th>
                <th>Title</th>
                <th>Severity</th>
                <th>Effort</th>
                <th>Deadline</th>
                <th>Action</th>
                <th>Verification</th>
                <th>Owner</th>
            </tr>
        </thead>
        <tbody>
            {% for entry in tier1 %}
            <tr>
                <td><code>{{ entry.finding_id | e }}</code></td>
                <td>{{ entry.title | e }}</td>
                <td>{{ entry.severity | e }}</td>
                <td>{{ entry.effort | e }}</td>
                <td>{{ entry.deadline | e }}</td>
                <td>{{ entry.action | e }}</td>
                <td>{{ entry.verification | e }}</td>
                <td>{{ entry.owner | e }}</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
    {% else %}
    <p>No Tier 1 remediation items.</p>
    {% endif %}

    <h3>Tier 2 — Short-Term (P1/P2)</h3>
    {% set tier2 = remediation_stages.get("tier_2_short_term", []) if remediation_stages is defined else [] %}
    {% if tier2 %}
    <table>
        <thead>
            <tr>
                <th>Finding ID</th>
                <th>Title</th>
                <th>Severity</th>
                <th>Effort</th>
                <th>Deadline</th>
                <th>Action</th>
                <th>Verification</th>
                <th>Owner</th>
            </tr>
        </thead>
        <tbody>
            {% for entry in tier2 %}
            <tr>
                <td><code>{{ entry.finding_id | e }}</code></td>
                <td>{{ entry.title | e }}</td>
                <td>{{ entry.severity | e }}</td>
                <td>{{ entry.effort | e }}</td>
                <td>{{ entry.deadline | e }}</td>
                <td>{{ entry.action | e }}</td>
                <td>{{ entry.verification | e }}</td>
                <td>{{ entry.owner | e }}</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
    {% else %}
    <p>No Tier 2 remediation items.</p>
    {% endif %}

    <h3>Tier 3 — Architectural (P3)</h3>
    {% set tier3 = remediation_stages.get("tier_3_architectural", []) if remediation_stages is defined else [] %}
    {% if tier3 %}
    <table>
        <thead>
            <tr>
                <th>Category</th>
                <th>Action</th>
                <th>Effort</th>
                <th>Owner</th>
                <th>Affected Layer</th>
                <th>Priority</th>
                <th>Deadline</th>
                <th>Rollback Risk</th>
                <th>Acceptance Criteria</th>
            </tr>
        </thead>
        <tbody>
            {% for entry in tier3 %}
            <tr>
                <td>{{ entry.category | e }}</td>
                <td>{{ entry.action | e }}</td>
                <td>{{ entry.effort | e }}</td>
                <td>{{ entry.owner | e }}</td>
                <td>{{ entry.affected_layer | e }}</td>
                <td>{{ entry.priority | e }}</td>
                <td>{{ entry.deadline | e }}</td>
                <td>{{ entry.rollback_risk | e }}</td>
                <td>{{ entry.acceptance_criteria | e }}</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
    {% else %}
    <p>No Tier 3 architectural items.</p>
    {% endif %}

    <h3>Priority Roadmap</h3>
    <div class="ai-slot-body">
        {% set road = ai_sections.get("prioritization_roadmap") if ai_sections is defined else "" %}
        {% if road and road.strip() %}
            {{ road | md | safe }}
        {% else %}
            <p>Prioritize remediation by validated severity, evidence quality, and exposed attack surface. Inconclusive areas require follow-up testing before risk acceptance.</p>
        {% endif %}
    </div>
    {% if infra_recommendations is defined and infra_recommendations %}
    <h3>Infrastructure Recommendations</h3>
    {% set ir = infra_recommendations %}
    {% if ir.config_snippets %}
    <h4>Technology-Specific Configuration</h4>
    {% for tech, snippet in ir.config_snippets %}
    <pre class="code-block">{{ snippet | e }}</pre>
    {% endfor %}
    {% endif %}
    {% if ir.tls_hardening %}
    <h4>TLS / SSL Hardening</h4>
    <pre class="code-block">{{ ir.tls_hardening | e }}</pre>
    {% endif %}
    {% if ir.header_recommendations %}
    <h4>Missing Security Headers</h4>
    <ul>
    {% for rec in ir.header_recommendations %}
        <li><code>{{ rec | e }}</code></li>
    {% endfor %}
    </ul>
    {% endif %}
    {% if ir.owasp_gap_roadmap %}
    <h4>OWASP Gap Closure Roadmap</h4>
    <table>
        <thead><tr><th>Category</th><th>Manual Test Hint</th><th>Priority</th></tr></thead>
        <tbody>
        {% for row in ir.owasp_gap_roadmap %}
            <tr><td>{{ row.category | e }}</td><td>{{ row.manual_test_hint | e }}</td><td>{{ row.priority | e }}</td></tr>
        {% endfor %}
        </tbody>
    </table>
    {% endif %}
    <hr>
    {% endif %}

    <h3>Responsible Parties and Timelines</h3>
    <table>
        <thead>
            <tr>
                <th>Vulnerability</th>
                <th>Responsible Department</th>
                <th>Recommended Timeline</th>
            </tr>
        </thead>
        <tbody>
            {% if findings %}
                {% for row in findings if row.severity in ["critical", "high"] %}
                <tr>
                    <td><code>{{ row.id | e }}</code> — {{ row.title | e }} ({{ row.severity | e }})</td>
                    <td>To be determined based on organizational priorities</td>
                    <td>{% if row.severity == "critical" %}Immediate (0–48 hours){% else %}Short-term (1–2 weeks){% endif %}</td>
                </tr>
                {% endfor %}
                {% for row in findings if row.severity in ["medium", "low"] %}
                <tr>
                    <td><code>{{ row.id | e }}</code> — {{ row.title | e }} ({{ row.severity | e }})</td>
                    <td>To be determined based on organizational priorities</td>
                    <td>{% if row.severity == "medium" %}Medium-term (1–3 months){% else %}Planned maintenance cycle{% endif %}</td>
                </tr>
                {% endfor %}
            {% else %}
                <tr>
                    <td colspan="3" class="empty">No vulnerability data available. Timelines to be determined based on organizational priorities.</td>
                </tr>
            {% endif %}
        </tbody>
    </table>
</section>

<section class="valhalla-ownership panel" id="ownership-evidence">
    <h3>Endpoint Ownership Evidence</h3>
    {% set oe = vc.ownership_evidence if vc is defined and vc.ownership_evidence is defined else none %}
    {% if oe and (oe.whois_org or oe.tls_subject or oe.tls_issuer or oe.dns_ns_records or oe.ip_whois_org) %}
    <table>
        <thead>
            <tr><th>Attribute</th><th>Value</th></tr>
        </thead>
        <tbody>
            <tr><td>Domain</td><td>{{ oe.domain | e }}</td></tr>
            {% if oe.whois_registrar %}<tr><td>WHOIS Registrar</td><td>{{ oe.whois_registrar | e }}</td></tr>{% endif %}
            {% if oe.whois_org %}<tr><td>WHOIS Organization</td><td>{{ oe.whois_org | e }}</td></tr>{% endif %}
            {% if oe.whois_creation_date %}<tr><td>WHOIS Creation Date</td><td>{{ oe.whois_creation_date | e }}</td></tr>{% endif %}
            {% if oe.whois_expiry_date %}<tr><td>WHOIS Expiry Date</td><td>{{ oe.whois_expiry_date | e }}</td></tr>{% endif %}
            {% if oe.tls_subject %}<tr><td>TLS Certificate Subject</td><td>{{ oe.tls_subject | e }}</td></tr>{% endif %}
            {% if oe.tls_issuer %}<tr><td>TLS Certificate Issuer</td><td>{{ oe.tls_issuer | e }}</td></tr>{% endif %}
            {% if oe.tls_SANs %}<tr><td>TLS SANs</td><td>{{ oe.tls_SANs | join(", ") | e }}</td></tr>{% endif %}
            {% if oe.dns_soa_primary_ns %}<tr><td>DNS SOA Primary NS</td><td>{{ oe.dns_soa_primary_ns | e }}</td></tr>{% endif %}
            {% if oe.dns_ns_records %}<tr><td>DNS NS Records</td><td>{{ oe.dns_ns_records | join(", ") | e }}</td></tr>{% endif %}
            {% if oe.dns_mx_records %}<tr><td>DNS MX Records</td><td>{{ oe.dns_mx_records | join(", ") | e }}</td></tr>{% endif %}
            {% if oe.ip_whois_org %}<tr><td>IP WHOIS Organization</td><td>{{ oe.ip_whois_org | e }}</td></tr>{% endif %}
            {% if oe.ip_whois_asn %}<tr><td>IP ASN</td><td>{{ oe.ip_whois_asn | e }}</td></tr>{% endif %}
            {% if oe.ip_country %}<tr><td>IP Country</td><td>{{ oe.ip_country | e }}</td></tr>{% endif %}
            <tr><td>Ownership Confidence</td><td>{{ oe.ownership_confidence | e }}</td></tr>
        </tbody>
    </table>
    {% else %}
    <p class="empty">No ownership evidence (WHOIS, TLS certificate, DNS, IP) was collected for this engagement. Ownership of the target could not be independently verified.</p>
    {% endif %}
</section>

{% set rp = vc.retest_plan if vc is defined and vc.retest_plan is defined else none %}
{% if rp and rp.retest_scope %}
<section class="valhalla-retest panel" id="retest-plan">
    <h3>Retest After Remediation Plan</h3>
    {% if rp.retest_timeline %}<p><strong>Timeline:</strong> {{ rp.retest_timeline | e }}</p>{% endif %}
    {% if rp.retest_methodology %}<p><strong>Methodology:</strong> {{ rp.retest_methodology | e }}</p>{% endif %}
    {% if rp.retest_acceptance_criteria %}<p><strong>Acceptance Criteria:</strong> {{ rp.retest_acceptance_criteria | e }}</p>{% endif %}
    <table>
        <thead>
            <tr>
                <th>Finding ID</th>
                <th>Title</th>
                <th>Severity</th>
                <th>Verification Command</th>
                <th>Expected Result</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            {% for item in rp.retest_scope %}
            <tr>
                <td><code>{{ item.finding_id | e }}</code></td>
                <td>{{ item.title | e }}</td>
                <td>{{ item.severity | e }}</td>
                <td><code>{{ item.verification_command | e }}</code></td>
                <td>{{ item.expected_result | e }}</td>
                <td>{{ item.retest_status | e }}</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</section>
{% endif %}

<section class="valhalla-zero-day panel" id="zero-day-potential">
    <h2>Novel Vulnerability Indication</h2>
    <div class="ai-slot-body">
        {% set zd = ai_sections.get("zero_day_potential") if ai_sections is defined else "" %}
        {% if zd and zd.strip() %}
            {{ zd | md | safe }}
        {% else %}
            <p>Novel vulnerability indication: Not indicated. No novel vulnerability class was demonstrated in the collected evidence.</p>
        {% endif %}
    </div>
</section>

<section class="valhalla-conclusion panel" id="conclusion">
    <h2>Conclusion</h2>
    <h3>Overall Assessment</h3>
    <div class="ai-slot-body">
        {% set ca = ai_sections.get("conclusion_assessment") if ai_sections is defined else "" %}
        {% if ca and ca.strip() %}
            {{ ca | md | safe }}
        {% else %}
            <p>This report is limited to the evidence-backed findings and documented coverage limitations. Missing or failed assessment areas must be treated as inconclusive, not as clean security results.</p>
        {% endif %}
    </div>
    <h3>Hardening Recommendations</h3>
    <p class="meta"><strong>HTTP security headers (stack-neutral):</strong> prefer a strict <strong>Content-Security-Policy</strong>, <strong>X-Content-Type-Options: nosniff</strong>, <strong>Referrer-Policy</strong>, a deliberate <strong>Permissions-Policy</strong>, framing control via <strong>CSP <code>frame-ancestors</code></strong> (or <code>X-Frame-Options</code> as a transitional measure), <strong>Strict-Transport-Security</strong> for HTTPS sites, and where appropriate <strong>Cross-Origin-Opener-Policy</strong> / <strong>Cross-Origin-Resource-Policy</strong>. Avoid legacy browser XSS filter headers (deprecated). Verify with <code>curl -sS -D- -o /dev/null &lt;url&gt;</code> (or equivalent) and review redirects.</p>
    <div class="ai-slot-body">
        {% set hd = ai_sections.get("hardening_recommendations") if ai_sections is defined else "" %}
        {% if hd and hd.strip() %}
            {{ hd | md | safe }}
        {% else %}
            <p>Apply stack-neutral hardening based on verified findings and parsed technical evidence. Avoid framework-specific examples unless the stack is confirmed.</p>
        {% endif %}
    </div>
    <h3>Remediation Steps and Production Readiness</h3>
    <div class="ai-slot-body">
        {% set rs = ai_sections.get("remediation_step") if ai_sections is defined else "" %}
        {% if rs and rs.strip() %}
            {{ rs | md | safe }}
        {% else %}
            <p>Each remediation item should be verified with repeatable requests, timestamps, and raw request/response evidence where applicable.</p>
        {% endif %}
    </div>
    <h3>Additional Vulnerability Descriptions</h3>
    <div class="ai-slot-body">
        {% set vd = ai_sections.get("vulnerability_description") if ai_sections is defined else "" %}
        {% if vd and vd.strip() %}
            {{ vd | md | safe }}
        {% else %}
            <p>No additional vulnerability narrative is available beyond the evidence-backed findings table and technical sections.</p>
        {% endif %}
    </div>
</section>
