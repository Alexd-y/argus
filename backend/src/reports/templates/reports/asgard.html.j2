{# Asgard tier — PAID scan report (first paid tier). Standalone dark
   "security-console" theme (tokens from valhalla_secreport_base.html.j2) so it
   is visually indistinguishable from Valhalla and identical in content to the
   branded Asgard PDF. Does NOT extend base.html.j2 — the legacy light shell
   drags in Phase Artifacts / recon dump / raw tool output / the object-key
   evidence register, none of which belong in Asgard (prompt §1/§2). Reads only
   ``asgard_payload`` (built by src/reports/asgard_paid.py). #}
{% set p = asgard_payload or {} %}
{% set m = p.get('meta', {}) %}
{% set sev = p.get('severity_counts', {}) %}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ m.get('brand_name') or 'Svalbard Security Inc.' }} — Asgard — {{ m.get('target') }}</title>
<style>
:root{
  --bg:#0a0c10;--surface:#111318;--surface2:#1a1d24;--surface3:#0f1116;
  --border:#252830;--border2:#333743;
  --accent:#00ff9d;--accent2:#ff3e6c;--accent3:#ffd700;
  --text:#e8eaf0;--text-muted:#8d94a3;--text-dim:#666c7a;
  --crit:#ff3e6c;--high:#ff6b2b;--med:#ffd700;--low:#00c8ff;--info:#a0a8b8;
  --font-head:system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;
  --font-mono:"Consolas","Courier New",monospace;
}
*{box-sizing:border-box;}
body{margin:0;background:var(--bg);color:var(--text);font-family:var(--font-mono);font-size:13px;line-height:1.6;}
.page{max-width:900px;margin:0 auto;padding:0 28px 64px;}
a{color:var(--accent);text-decoration:none;}
code{background:#06070a;border:1px solid var(--border);border-radius:4px;color:var(--accent);padding:.06rem .3rem;word-break:break-word;}
h2{font-family:var(--font-head);font-size:16px;letter-spacing:.14em;text-transform:uppercase;color:var(--text);margin:2.4rem 0 .9rem;padding-bottom:.5rem;border-bottom:1px solid var(--border2);}
h2 .idx{color:var(--accent);margin-right:.6rem;}
h3{font-family:var(--font-head);font-size:12.5px;letter-spacing:.08em;text-transform:uppercase;color:var(--text-muted);margin:1.4rem 0 .5rem;}
.app-header{display:flex;align-items:center;gap:16px;background:var(--surface);border-bottom:1px solid var(--border);padding:16px 28px;}
.app-header h1{font-family:var(--font-head);font-size:20px;font-weight:800;letter-spacing:.04em;margin:0;color:var(--accent);}
.app-header h1 span{color:var(--text-muted);font-weight:600;}
.app-header .hmeta{margin-left:auto;text-align:right;color:var(--text-dim);font-size:11px;line-height:1.5;}
.cover{background:linear-gradient(180deg,var(--surface) 0%,var(--surface3) 100%);border:1px solid var(--border);border-radius:10px;padding:30px 30px 26px;margin-top:26px;}
.cover .kicker{color:var(--accent);letter-spacing:.22em;text-transform:uppercase;font-size:11px;}
.cover .title{font-family:var(--font-head);font-size:30px;font-weight:800;margin:.35rem 0 .1rem;color:var(--text);}
.cover .target{font-size:15px;color:var(--text-muted);}
.cover .target b{color:var(--low);}
.badges{margin:16px 0 14px;display:flex;gap:10px;flex-wrap:wrap;}
.badge{display:inline-block;padding:.28rem .7rem;border-radius:5px;font-size:11px;letter-spacing:.08em;text-transform:uppercase;border:1px solid var(--border2);}
.badge.tier{background:rgba(0,255,157,.08);border-color:rgba(0,255,157,.4);color:var(--accent);}
.badge.paid{background:rgba(255,215,0,.08);border-color:rgba(255,215,0,.4);color:var(--accent3);}
.tagline{background:var(--surface2);border:1px solid var(--border);border-left:3px solid var(--accent);border-radius:6px;padding:12px 14px;color:var(--text-muted);font-size:12.5px;margin-top:4px;}
.scanmeta{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--border);border:1px solid var(--border);border-radius:6px;overflow:hidden;margin-top:18px;}
.scanmeta div{background:var(--surface);padding:10px 14px;}
.scanmeta .l{color:var(--text-dim);font-size:10px;letter-spacing:.1em;text-transform:uppercase;}
.scanmeta .v{color:var(--text);font-size:13px;margin-top:2px;word-break:break-word;}
.sev-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:12px;margin-top:6px;}
.sev-tile{background:var(--surface);border:1px solid var(--border);border-top:3px solid var(--border2);border-radius:8px;padding:14px 12px;text-align:center;}
.sev-tile .n{font-family:var(--font-head);font-size:30px;font-weight:800;line-height:1;}
.sev-tile .lbl{margin-top:6px;font-size:10px;letter-spacing:.12em;text-transform:uppercase;color:var(--text-muted);}
.sev-tile.crit{border-top-color:var(--crit);} .sev-tile.crit .n{color:var(--crit);}
.sev-tile.high{border-top-color:var(--high);} .sev-tile.high .n{color:var(--high);}
.sev-tile.med{border-top-color:var(--med);} .sev-tile.med .n{color:var(--med);}
.sev-tile.low{border-top-color:var(--low);} .sev-tile.low .n{color:var(--low);}
.sev-tile.info{border-top-color:var(--info);} .sev-tile.info .n{color:var(--info);}
.muted{color:var(--text-muted);} .lead{margin-top:-.3rem;}
table{width:100%;border-collapse:collapse;margin-top:.4rem;font-size:12px;}
th,td{border:1px solid var(--border);padding:.5rem .6rem;text-align:left;vertical-align:top;}
th{background:var(--surface2);color:var(--text-muted);font-family:var(--font-head);font-size:10.5px;letter-spacing:.09em;text-transform:uppercase;font-weight:700;}
td{background:var(--surface3);word-break:break-word;}
.sev-dot{display:inline-block;padding:.12rem .55rem;border-radius:4px;font-size:10.5px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;}
.d-crit{background:rgba(255,62,108,.14);color:var(--crit);}
.d-high{background:rgba(255,107,43,.14);color:var(--high);}
.d-med{background:rgba(255,215,0,.14);color:var(--med);}
.d-low{background:rgba(0,200,255,.14);color:var(--low);}
.d-info{background:rgba(160,168,184,.14);color:var(--info);}
.ok{color:var(--accent);} .bad{color:var(--accent2);}
.finding{background:var(--surface);border:1px solid var(--border);border-left:3px solid var(--border2);border-radius:8px;padding:16px 18px;margin-top:14px;break-inside:avoid;page-break-inside:avoid;}
.finding.crit{border-left-color:var(--crit);} .finding.high{border-left-color:var(--high);}
.finding.med{border-left-color:var(--med);} .finding.low{border-left-color:var(--low);} .finding.info{border-left-color:var(--info);}
.finding .fh{display:flex;align-items:center;gap:10px;flex-wrap:wrap;}
.finding .ft{font-family:var(--font-head);font-size:15px;font-weight:700;color:var(--text);margin:0;letter-spacing:0;text-transform:none;}
.finding .fid{margin-left:auto;font-size:10px;color:var(--text-dim);}
.metaline{display:flex;gap:16px;flex-wrap:wrap;color:var(--text-dim);font-size:11px;margin:8px 0 12px;}
.metaline b{color:var(--text-muted);font-weight:600;}
.blk{margin:11px 0;}
.blk .lbl{font-family:var(--font-head);font-size:10.5px;letter-spacing:.11em;text-transform:uppercase;color:var(--accent);margin-bottom:4px;}
.evidence{background:#06070a;border:1px solid var(--border);border-radius:6px;padding:10px 12px;color:#cfd3dd;font-size:11.5px;white-space:pre-wrap;word-break:break-word;}
ol.fix{margin:.2rem 0 0;padding-left:1.15rem;} ol.fix li{margin:.22rem 0;}
.panel{background:var(--surface);border:1px solid var(--border);border-radius:8px;padding:16px 18px;break-inside:avoid;}
.panel h3{margin-top:0;}
.footnote{background:var(--surface2);border:1px solid var(--border);border-left:3px solid var(--accent3);border-radius:6px;padding:12px 14px;color:var(--text-muted);font-size:12px;margin-top:14px;}
.footnote b{color:var(--text);}
footer{margin-top:40px;padding-top:16px;border-top:1px solid var(--border);color:var(--text-dim);font-size:10.5px;line-height:1.7;}
@media print{
  @page{size:A4;margin:14mm 12mm;background:#0a0c10;}
  body{background:#0a0c10 !important;-webkit-print-color-adjust:exact;print-color-adjust:exact;}
  .app-header{position:static;}
  h2{page-break-after:avoid;}
  .finding,.panel{break-inside:avoid;}
}
</style></head>
<body>
<div class="app-header">
<h1>{{ (m.get('brand_name') or 'SVALBARD SECURITY INC.') | upper }}<span> // Asgard</span></h1>
<div class="hmeta">scan {{ m.get('scan_id') or '—' }}<br>{{ m.get('tier_label') or 'Asgard' }} · Paid · {{ m.get('rescan_cadence') or '' }}</div>
</div>
<div class="page">
<section class="cover">
<div class="kicker">External Security Assessment</div>
<div class="title">Security Team Brief</div>
<div class="target">Target: <b>{{ m.get('target') or 'Unspecified target' }}</b></div>
<div class="badges">
<span class="badge tier">{{ m.get('tier_label') or 'Asgard' }}</span>
<span class="badge paid">{{ m.get('plan_price') or '' }}</span>
</div>
<div class="tagline">{{ m.get('plan_blurb') or '' }}</div>
<div class="scanmeta">
<div><div class="l">Status</div><div class="v">Completed</div></div>
<div><div class="l">Scope</div><div class="v">{{ m.get('scope') or m.get('target') or '—' }}</div></div>
<div><div class="l">Findings</div><div class="v">{{ (p.get('findings') or []) | length }} total</div></div>
<div><div class="l">Scan ID</div><div class="v">{{ m.get('scan_id') or '—' }}</div></div>
<div><div class="l">Window</div><div class="v">{{ m.get('engagement_window') or m.get('completed_at') or '—' }}</div></div>
<div><div class="l">Rescans</div><div class="v">{{ m.get('rescan_cadence') or '—' }}</div></div>
</div></section>

<h2><span class="idx">01</span>Severity Summary</h2>
<div class="sev-grid">
<div class="sev-tile crit"><div class="n">{{ sev.get('critical', 0) }}</div><div class="lbl">Critical</div></div>
<div class="sev-tile high"><div class="n">{{ sev.get('high', 0) }}</div><div class="lbl">High</div></div>
<div class="sev-tile med"><div class="n">{{ sev.get('medium', 0) }}</div><div class="lbl">Medium</div></div>
<div class="sev-tile low"><div class="n">{{ sev.get('low', 0) }}</div><div class="lbl">Low</div></div>
<div class="sev-tile info"><div class="n">{{ sev.get('info', 0) }}</div><div class="lbl">Info</div></div>
</div>

{% set ai = p.get('ai_conclusions', {}) %}
<h2><span class="idx">02</span>Executive Summary</h2>
<div class="panel"><p style="margin:0">{{ ai.get('vulnerability_description') or '' }}</p></div>

<h2><span class="idx">03</span>Findings</h2>
<p class="muted lead">Every finding, most urgent first. Critical and important (high) findings carry full evidence and remediation.</p>
{% for f in p.get('findings', []) %}
<div class="finding {{ f.severity or 'info' }}">
<div class="fh">
<h3 class="ft">{{ f.title }}</h3>
<span class="fid">{{ f.id }}</span></div>
<div class="metaline">
<span><span class="sev-dot d-{{ f.severity or 'info' }}">{{ (f.severity or 'info') | capitalize }}</span></span>
<span><b>CWE:</b> {{ f.cwe or '—' }}</span>
<span><b>OWASP:</b> {{ f.owasp or '—' }}</span>
<span><b>CVSS:</b> {{ '%.1f' | format(f.cvss) if f.cvss is not none else '—' }}</span>
<span><b>Status:</b> {{ f.status or '—' }}</span>
<span><b>Asset:</b> {{ f.asset or '—' }}</span>
</div>
<div class="blk"><div class="lbl">What we found</div><div>{{ f.what }}</div></div>
{% if f.exploit_demonstrated %}<div class="blk"><div class="lbl">Exploitation</div><div>Confirmed exploitable during testing{% if f.exploit_summary %} — {{ f.exploit_summary }}{% endif %}.</div></div>{% endif %}
{% if f.evidence %}<div class="blk"><div class="lbl">Evidence</div><div class="evidence">{{ f.evidence }}</div></div>{% endif %}
{% if f.negative_control %}<div class="blk"><div class="lbl">Negative control</div><div>{{ f.negative_control }}</div></div>{% endif %}
<div class="blk"><div class="lbl">Why it matters</div><div>{{ f.why }}</div></div>
<div class="blk"><div class="lbl">Recommended remediation</div><ol class="fix">
{% for step in f.remediation or [] %}<li>{{ step }}</li>{% endfor %}
</ol></div>
{% if f.cvss_vector %}<div class="blk"><div class="lbl">CVSS vector</div><code>{{ f.cvss_vector }}</code></div>{% endif %}
{% if f.validation %}<div class="blk"><div class="lbl">Validation</div><div>{{ f.validation }}</div></div>{% endif %}
</div>
{% endfor %}

{% set tls = p.get('tls_analysis', {}) %}
<h2><span class="idx">04</span>TLS &amp; Transport Analysis</h2>
<p class="muted lead">{{ tls.get('summary') or '' }}</p>
<table><thead><tr><th>Check</th><th>Result</th><th>Detail</th></tr></thead><tbody>
{% for r in tls.get('rows', []) %}
<tr><td>{{ r.check }}</td><td class="{{ 'bad' if r.status == 'fail' else ('ok' if r.status == 'pass' else '') }}">{{ r.result }}</td><td>{{ r.detail }}</td></tr>
{% endfor %}
</tbody></table>
{% if tls.get('remediation') %}
<div class="blk"><div class="lbl">Recommended remediation</div><ol class="fix">
{% for step in tls.get('remediation') %}<li>{{ step }}</li>{% endfor %}
</ol></div>
{% endif %}

{% set hdr = p.get('header_analysis', {}) %}
<h2><span class="idx">05</span>HTTP Security Headers</h2>
<p class="muted lead">{{ hdr.get('summary') or '' }}</p>
<table><thead><tr><th>Header</th><th>Status</th><th>Recommendation</th></tr></thead><tbody>
{% for r in hdr.get('rows', []) %}
<tr><td><code>{{ r.header }}</code></td><td>{% if r.present %}<span class="ok">Present</span>{% else %}<span class="bad">Missing</span>{% endif %}</td><td>{{ r.recommended }}</td></tr>
{% endfor %}
</tbody></table>

{% set dw = p.get('dark_web', {}) %}
<h2><span class="idx">06</span>Leaked-Credential Monitoring</h2>
<p class="muted lead">{{ dw.get('summary') or '' }}</p>
<div class="scanmeta" style="grid-template-columns:repeat(4,1fr)">
<div><div class="l">Monitored domain</div><div class="v">{{ dw.get('monitored_domain') or '—' }}</div></div>
<div><div class="l">New exposures</div><div class="v">{{ dw.get('new_exposures', 0) }}</div></div>
<div><div class="l">Total tracked</div><div class="v">{{ dw.get('total_tracked', 0) }}</div></div>
<div><div class="l">Last checked</div><div class="v">{{ dw.get('last_checked') or '—' }}</div></div>
</div>
<p class="muted">Counts only are shown here; any match is delivered to the security team through the evidence locker, never in plaintext in this document.</p>

<h2><span class="idx">07</span>OWASP Top 10 Alignment</h2>
<table><thead><tr><th>OWASP category</th><th>Findings</th></tr></thead><tbody>
{% for r in p.get('owasp_alignment', []) %}
<tr><td>{{ r.category }}</td><td>{{ r.count }}</td></tr>
{% endfor %}
</tbody></table>

<h2><span class="idx">08</span>AI Conclusions</h2>
<div class="panel">
<h3>Vulnerability Description</h3>
<p style="margin:.2rem 0 0">{{ ai.get('vulnerability_description') or '' }}</p>
<h3 style="margin-top:1.2rem">Business Risk</h3>
<p style="margin:.2rem 0 0">{{ ai.get('business_risk') or '' }}</p>
<h3 style="margin-top:1.2rem">Prioritized Roadmap</h3>
<ol class="fix">
{% for step in ai.get('prioritized_roadmap', []) %}<li>{{ step }}</li>{% endfor %}
</ol></div>

<div class="footnote"><b>{{ m.get('tier_label') or 'Asgard' }} plan — {{ m.get('plan_price') or '' }}.</b> {{ m.get('plan_blurb') or '' }} Full proof-of-concept, raw evidence, exploit chains and the executive business-impact lens are delivered in the Valhalla report.</div>
<footer>
<div>{{ m.get('brand_name') or 'Svalbard Security Inc.' }} · Asgard (paid) · scan {{ m.get('scan_id') or '—' }} · generated {{ m.get('generated_at') or '—' }}</div>
<div style="margin-top:6px">Testing was scoped to assets the requester is authorized to assess. Reproducer commands are sanitized. This report excludes raw tool output, phase artifacts and reconnaissance dumps by design.</div>
</footer></div></body></html>
