#!/usr/bin/env bash
# secretfinder-wrapper — argv adapter for SecretFinder (tool_id: secretfinder).
#
# Catalog contract (backend/config/tools/secretfinder.yaml):
#   secretfinder-wrapper -i <js.txt> -o cli -out <path>
# Upstream SecretFinder (m4ll0k/SecretFinder) scans ONE JS URL per invocation
# (`-i <url>`), emitting HTML-ish output. This wrapper iterates every JS URL in
# <js.txt>, runs SecretFinder per URL, strips HTML tags and aggregates one
# finding per line at <path>.
#
# Fail-safe: always creates <out> (empty on any error / missing input).
set -uo pipefail

jsfile=""
ofmt="cli"
out="/out/secretfinder.txt"

while [ $# -gt 0 ]; do
  case "$1" in
    -i) jsfile="${2:-}"; shift 2 ;;
    -o) ofmt="${2:-cli}"; shift 2 ;;
    -out) out="${2:-$out}"; shift 2 ;;
    *) shift ;;
  esac
done

mkdir -p "$(dirname "$out")" 2>/dev/null || true
: > "$out"

if [ -z "$jsfile" ] || [ ! -f "$jsfile" ]; then
  echo "secretfinder-wrapper: missing/empty -i input file" >&2
  exit 2
fi

sf_bin="$(command -v secretfinder || command -v SecretFinder.py || command -v secretfinder.py || true)"
if [ -z "$sf_bin" ]; then
  echo "secretfinder-wrapper: SecretFinder not found on PATH" >&2
  exit 3
fi

while IFS= read -r js; do
  [ -z "$js" ] && continue
  # Strip HTML tags → one secret per line; tolerate per-URL failures.
  "$sf_bin" -i "$js" -o "$ofmt" 2>/dev/null | sed 's/<[^>]*>//g' | grep -aE '\S' >>"$out" 2>/dev/null || true
done <"$jsfile"
