#!/usr/bin/env bash
# subjs-wrapper — argv adapter for subjs (tool_id: subjs).
#
# Catalog contract (backend/config/tools/subjs.yaml):
#   subjs-wrapper -i <urls.txt> -out <path>
# Upstream subjs (lc/subjs) extracts JS file URLs referenced by an input list.
# It accepts `-i <file>`; we also fall back to a stdin pipe for robustness.
#
# Fail-safe: always creates <out> (empty on any error / missing input).
set -uo pipefail

infile=""
out="/out/subjs.txt"

while [ $# -gt 0 ]; do
  case "$1" in
    -i) infile="${2:-}"; shift 2 ;;
    -out) out="${2:-$out}"; shift 2 ;;
    *) shift ;;
  esac
done

mkdir -p "$(dirname "$out")" 2>/dev/null || true
: > "$out"

if [ -z "$infile" ] || [ ! -f "$infile" ]; then
  echo "subjs-wrapper: missing/empty -i input file" >&2
  exit 2
fi
if ! command -v subjs >/dev/null 2>&1; then
  echo "subjs-wrapper: subjs not found on PATH" >&2
  exit 3
fi

subjs -i "$infile" >"$out" 2>/dev/null \
  || subjs <"$infile" >"$out" 2>/dev/null \
  || : >"$out"
