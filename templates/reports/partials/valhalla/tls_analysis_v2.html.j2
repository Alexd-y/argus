# TLS Analysis Table Template

<table class="tls-analysis-table">
  <thead>
    <tr>
      <th>Domain</th>
      <th>Certificate Subject</th>
      <th>Issuer</th>
      <th>Validity</th>
      <th>TLS 1.0</th>
      <th>TLS 1.1</th>
      <th>TLS 1.2</th>
      <th>TLS 1.3</th>
      <th>Weak Ciphers</th>
      <th>HSTS</th>
      <th>Grade</th>
    </tr>
  </thead>
  <tbody>
    {% for domain, analysis in tls_analysis.items() %}
    <tr>
      <td>{{ domain }}</td>
      <td>{{ analysis.cert_chain[0].subject if analysis.cert_chain else 'N/A' }}</td>
      <td>{{ analysis.cert_chain[0].issuer if analysis.cert_chain else 'N/A' }}</td>
      <td>{{ analysis.cert_chain[0].expiry if analysis.cert_chain else 'N/A' }}</td>
      <td>{% for p in analysis.protocols %}{% if p.name == 'TLSv1.0' %}{{ '❌' if not p.enabled else '✅' }}{% endif %}{% endfor %}</td>
      <td>{% for p in analysis.protocols %}{% if p.name == 'TLSv1.1' %}{{ '❌' if not p.enabled else '✅' }}{% endif %}{% endfor %}</td>
      <td>{% for p in analysis.protocols %}{% if p.name == 'TLSv1.2' %}{{ '✅' if p.enabled else '❌' }}{% endif %}{% endfor %}</td>
      <td>{% for p in analysis.protocols %}{% if p.name == 'TLSv1.3' %}{{ '✅' if p.enabled else '❌' }}{% endif %}{% endfor %}</td>
      <td>{{ analysis.ciphers | selectattr('weak', 'equalto', true) | list | length }}</td>
      <td>{{ analysis.hsts or 'N/A' }}</td>
      <td>{{ analysis.grade }}</td>
    </tr>
    {% endfor %}
  </tbody>
</table>
