# Isolated validation stack env (copy to infra/.env.validation, which is gitignored).
# Dev-only values — NOT production secrets. The validation stack is disposable.

VALIDATION_POSTGRES_USER=argus
VALIDATION_POSTGRES_PASSWORD=argus_validation
VALIDATION_POSTGRES_DB=argus_test
VALIDATION_PG_PORT=55432

VALIDATION_REDIS_PORT=56379

VALIDATION_MINIO_ACCESS_KEY=argus
VALIDATION_MINIO_SECRET_KEY=argus_validation_secret
VALIDATION_MINIO_PORT=59000
VALIDATION_MINIO_CONSOLE_PORT=59001

# Client-side connection strings used by the backend test suite:
#   DATABASE_URL=postgresql+asyncpg://argus:argus_validation@localhost:55432/argus_test
#   REDIS_URL=redis://localhost:56379/0
#   MINIO_ENDPOINT=localhost:59000
