# ARGUS Sandbox — Kali-based pentest runner with fuzzing and symbolic execution tools.
#
# Multi-profile Dockerfile for the ARGUS sandbox container.
# Binary profile (default) includes ALL tools: recon, web VA, network,
# AFL++, angr, Z3, Jazzer, radare2, binwalk, libFuzzer, Playwright.
#
# Profiles:
#   SANDBOX_PROFILE=binary   — full pentest + fuzzing + symbolic execution (DEFAULT)
#   SANDBOX_PROFILE=standard — web/network/cloud/browser tools only
#   SANDBOX_PROFILE=full     — standard + metasploit
#
# Build:
#   docker compose -f infra/docker-compose.yml build sandbox
#   # Standalone:
#   podman build -f infra/Dockerfile.sandbox -t argus-sandbox .
#
# Security: runs as non-root user (argus:1000), no Docker socket mount,
#           read-only root filesystem except /workspace and /tmp.

ARG SANDBOX_PROFILE=binary

FROM docker.io/kalilinux/kali-rolling:latest AS base

# Base: common packages shared across all profiles
RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    python3 python3-pip python3-venv python3-dev \
    git curl wget gdb strace ltrace \
    libssl-dev libffi-dev libxml2-dev libxslt1-dev \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user (matches ephemeral_worker.py ContainerSpec user 1000:1000)
RUN groupadd -g 1000 argus && useradd -m -u 1000 -g 1000 -s /bin/bash argus

# ---- Standard profile: web/network/cloud/browser tools ----
FROM base AS standard
# Full web/VA tool coverage so the active-scan planner never logs tool_not_found:
# fingerprinting (whatweb), fuzzing (ffuf/wfuzz/feroxbuster/gobuster/dirsearch),
# injection (sqlmap/commix), WAF detection (wafw00f), parameter discovery (arjun),
# AD/SMB (crackmapexec/impacket/enum4linux-ng), OSINT (theharvester).
# Nuclei engine pin (infra/pins/nuclei.yaml): v3.11.1 @ a8c88feb4a1c8e961b7902534ce3af97e9d524a4
# Kali rolling may ship a different package. Override with:
#   go install -v github.com/projectdiscovery/nuclei/v3/cmd/nuclei@v3.11.1
# Templates pin: nuclei-templates v10.4.7 @ 83234ce456da3e90dda86dfbc5e605e64a846df3
RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    nmap masscan subfinder amass dnsrecon gobuster ffuf feroxbuster wfuzz nuclei httpx-toolkit \
    sqlmap nikto wpscan dirsearch commix \
    whatweb wafw00f arjun theharvester enum4linux-ng \
    hydra medusa crackmapexec impacket-scripts smbclient \
    sslscan testssl.sh \
    jq whois \
    && rm -rf /var/lib/apt/lists/*

# bloodhound — provides `bloodhound-python` for AD collection (exploitation phase).
RUN pip3 install --no-cache-dir --break-system-packages bloodhound

# corscanner — CORS misconfiguration scanner; the planner (cors_testing deep mode) invokes it
# as the `cors` binary. The PyPI `corscanner` package does NOT register the `cors` console_script,
# so install from upstream Git where setup.py declares `cors = CORScanner.cors_scan:main`, then
# fail the build if the entry point is somehow missing.
RUN pip3 install --no-cache-dir --break-system-packages \
    "git+https://github.com/chenjj/CORScanner.git"
RUN command -v cors >/dev/null 2>&1 || { echo "ERROR: cors binary not on PATH after CORScanner install"; exit 1; }

# whatwaf — WAF/IDS detection & bypass (planner deep-mode waf_detection). It is NOT published
# to PyPI, and its upstream setup.py prompts interactively (raw_input) when executed as root,
# which deadlocks non-interactive image builds. So we clone the source, install only its runtime
# dependencies, and expose a thin `whatwaf` launcher on PATH (the binary name the planner expects).
RUN git clone --depth 1 https://github.com/Ekultek/WhatWaf.git /opt/whatwaf \
    && pip3 install --no-cache-dir --break-system-packages -r /opt/whatwaf/requirements.txt \
    && printf '#!/bin/sh\n# whatwaf caches into ~/.whatwaf, but the sandbox rootfs (incl. /home/argus) is read-only\n# at runtime — only /tmp and /workspace are writable. Anchor HOME in /tmp so caching never fails.\nexport HOME=/tmp/whatwaf-home\nmkdir -p "$HOME/.whatwaf" 2>/dev/null || true\nexec python3 /opt/whatwaf/whatwaf.py "$@"\n' > /usr/local/bin/whatwaf \
    && chmod +x /usr/local/bin/whatwaf

# dalfox (Go binary — not in Kali apt, download pre-built release)
RUN DALFOX_VERSION=$(curl -sL --retry 5 https://api.github.com/repos/hahwul/dalfox/releases/latest | grep -oP '"tag_name":\s*"\K[^"]+' | head -1) && \
    ARCH=$(uname -m) && \
    if [ "$ARCH" = "x86_64" ]; then DALFOX_ARCH="x86_64"; elif [ "$ARCH" = "aarch64" ]; then DALFOX_ARCH="aarch64"; else DALFOX_ARCH="x86_64"; fi && \
    curl -sL --retry 5 "https://github.com/hahwul/dalfox/releases/download/${DALFOX_VERSION}/dalfox-${DALFOX_VERSION}-linux-${DALFOX_ARCH}.tar.gz" -o /tmp/dalfox.tar.gz && \
    tar xzf /tmp/dalfox.tar.gz -C /tmp/ && \
    find /tmp -maxdepth 2 -name 'dalfox' -type f -executable -exec mv {} /usr/local/bin/dalfox \; && \
    chmod +x /usr/local/bin/dalfox && \
    rm -f /tmp/dalfox.tar.gz

# Go toolchain — required to compile recon tools not packaged in Kali apt repos
# (katana, gau, waybackurls, assetfinder, naabu).
RUN ARCH=$(uname -m) && \
    if [ "$ARCH" = "x86_64" ]; then GO_ARCH="amd64"; elif [ "$ARCH" = "aarch64" ]; then GO_ARCH="arm64"; else GO_ARCH="amd64"; fi && \
    curl -sL --retry 5 "https://go.dev/dl/go1.23.4.linux-${GO_ARCH}.tar.gz" -o /tmp/go.tar.gz && \
    tar -C /usr/local -xzf /tmp/go.tar.gz && \
    rm -f /tmp/go.tar.gz
ENV PATH="/usr/local/go/bin:/root/go/bin:${PATH}" GOBIN=/usr/local/bin

# Recon tools compiled from Go source (not packaged in Kali apt).
RUN go install -v github.com/projectdiscovery/katana/cmd/katana@latest && \
    go install -v github.com/lc/gau/v2/cmd/gau@latest && \
    go install -v github.com/tomnomnom/waybackurls@latest && \
    go install -v github.com/tomnomnom/assetfinder@latest && \
    go install -v github.com/projectdiscovery/naabu/v2/cmd/naabu@latest

# findomain — subdomain enumeration (pre-built Rust binary, not in Kali apt).
RUN FINDOMAIN_VERSION=$(curl -sL --retry 5 https://api.github.com/repos/Findomain/Findomain/releases/latest | grep -oP '"tag_name":\s*"\K[^"]+' | head -1) && \
    curl -sL --retry 5 "https://github.com/Findomain/Findomain/releases/download/${FINDOMAIN_VERSION}/findomain-linux" -o /usr/local/bin/findomain && \
    chmod +x /usr/local/bin/findomain

# xsstrike (Python tool — not in Kali apt)
RUN pip3 install --no-cache-dir --break-system-packages xsstrike

# ARGUS invokes the ProjectDiscovery HTTP prober as `httpx` and the TLS auditor as
# `testssl.sh` (see backend/config/tools/{httpx,testssl}.yaml). Kali ships them under
# different names (`httpx-toolkit`; `testssl` / /usr/share/testssl.sh/testssl.sh), so
# symlink them to the names ARGUS expects — otherwise recon HTTP fingerprinting and the
# SSL/TLS findings phase silently no-op (tool "not found").
RUN set -e; \
    if ! command -v httpx >/dev/null 2>&1; then \
      t=$(command -v httpx-toolkit 2>/dev/null || true); \
      [ -n "$t" ] && ln -sf "$t" /usr/local/bin/httpx || true; \
    fi; \
    if ! command -v testssl.sh >/dev/null 2>&1; then \
      t=$(command -v testssl 2>/dev/null || true); \
      [ -z "$t" ] && [ -x /usr/share/testssl.sh/testssl.sh ] && t=/usr/share/testssl.sh/testssl.sh || true; \
      [ -n "$t" ] && ln -sf "$t" /usr/local/bin/testssl.sh || true; \
    fi; \
    if ! command -v theharvester >/dev/null 2>&1; then \
      t=$(command -v theHarvester 2>/dev/null || true); \
      [ -n "$t" ] && ln -sf "$t" /usr/local/bin/theharvester || true; \
    fi; \
    echo "tool-alias httpx -> $(command -v httpx || echo MISSING); testssl.sh -> $(command -v testssl.sh || echo MISSING); theharvester -> $(command -v theharvester || echo MISSING)"

# argus-tool-check — diagnostic script available in EVERY profile (standard/full/binary).
# Previously this lived only in the `binary` stage, so `docker exec argus-sandbox
# argus-tool-check` failed with "executable file not found" whenever SANDBOX_PROFILE=standard.
RUN printf '%s\n' \
    '#!/bin/sh' \
    "echo '=== ARGUS Sandbox tool check (web/recon) ==='" \
     'for t in nmap masscan subfinder amass katana gau waybackurls assetfinder findomain naabu dnsrecon gobuster ffuf feroxbuster wfuzz nuclei httpx sqlmap nikto wpscan dirsearch commix whatweb wafw00f whatwaf cors arjun theharvester sslscan testssl.sh hydra medusa crackmapexec; do' \
    '  if command -v "$t" >/dev/null 2>&1; then echo "$t: OK"; else echo "$t: MISSING"; fi' \
    'done' \
    > /usr/local/bin/argus-tool-check \
    && chmod +x /usr/local/bin/argus-tool-check

# ---- Full profile: standard + metasploit ----
FROM standard AS full
RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    metasploit-framework \
    && rm -rf /var/lib/apt/lists/*

# ---- Binary profile: standard + ALL fuzzing/symbolic/reverse tools ----
FROM standard AS binary

# AFL++ — state-of-the-art fuzzer (install from Kali repos to avoid source compilation)
RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    afl++ \
    && rm -rf /var/lib/apt/lists/*

# angr — binary analysis framework (Python)
RUN pip3 install --no-cache-dir --break-system-packages angr z3-solver pyelftools lief

# Jazzer — JVM fuzzing (pre-built release, avoid OOM from Maven build)
RUN JAZZER_VERSION=$(curl -sL --retry 5 https://api.github.com/repos/CodeIntelligenceTesting/jazzer/releases/latest | grep -oP '"tag_name":\s*"\K[^"]+' | head -1) && \
    ARCH=$(uname -m) && \
    if [ "$ARCH" = "aarch64" ]; then JAZZER_ARCH="arm64"; else JAZZER_ARCH="x86-64"; fi && \
    mkdir -p /opt/jazzer && \
    curl -sL --retry 5 "https://github.com/CodeIntelligenceTesting/jazzer/releases/download/${JAZZER_VERSION}/jazzer-linux-${JAZZER_ARCH}.tar.gz" -o /tmp/jazzer.tar.gz && \
    tar xzf /tmp/jazzer.tar.gz -C /opt/jazzer/ && \
    find /opt/jazzer -maxdepth 1 -name 'jazzer_standalone*' -type f -executable -exec ln -sf {} /usr/local/bin/jazzer_standalone \; && \
    find /opt/jazzer -maxdepth 1 -name 'jazzer' -type f -executable -exec ln -sf {} /usr/local/bin/jazzer \; && \
    rm -f /tmp/jazzer.tar.gz

# radare2 — reverse engineering (from Kali repos to avoid source build OOM)
RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    radare2 \
    && rm -rf /var/lib/apt/lists/*

# binwalk — firmware extraction
RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    binwalk python3-binwalk \
    && rm -rf /var/lib/apt/lists/*

# libFuzzer harness support (clang with built-in fuzzer)
RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    clang llvm \
    && rm -rf /var/lib/apt/lists/*

# Playwright + Chromium — browser automation for XSS/auth verification.
# Kali ships the `playwright` Python package but no Node.js runtime; the driver
# shells out to `node`, so without it `playwright install` fails with
# "FileNotFoundError: '/usr/bin/node'". Install nodejs first, and keep the Chromium
# browser download non-fatal so the image still builds in constrained/offline
# environments (Playwright XSS/auth verification is an optional enhancement).
RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/* \
    && pip3 install --no-cache-dir --break-system-packages playwright \
    && (python3 -m playwright install --with-deps chromium \
        || echo "playwright chromium install skipped (non-fatal)")

# Python requirements from ARGUS backend (for sandbox task execution)
COPY backend/requirements.txt /tmp/requirements.txt
RUN pip3 install --no-cache-dir --break-system-packages -r /tmp/requirements.txt \
    ; rm -f /tmp/requirements.txt

# Append binary-profile extras to the argus-tool-check created in the standard stage.
RUN printf '%s\n' \
    "echo '=== binary profile extras (fuzzing/symbolic/reverse) ==='" \
    'for t in afl-fuzz r2 binwalk clang jazzer jazzer_standalone; do' \
    '  if command -v "$t" >/dev/null 2>&1; then echo "$t: OK"; else echo "$t: MISSING"; fi' \
    'done' \
    'python3 -c "import angr; print(\"angr: OK\")" 2>/dev/null || echo "angr: MISSING"' \
    'python3 -c "import z3; print(\"z3: OK\")" 2>/dev/null || echo "z3: MISSING"' \
    'python3 -c "import playwright; print(\"playwright: OK\")" 2>/dev/null || echo "playwright: MISSING"' \
    >> /usr/local/bin/argus-tool-check

# Final image selector — picks the profile specified by SANDBOX_PROFILE arg
FROM ${SANDBOX_PROFILE} AS final

# Workspace mount point
RUN mkdir -p /workspace/artifacts /tmp/argus-sandbox && chown -R argus:argus /workspace /tmp/argus-sandbox

# Security hardening
RUN echo "argus ALL=(ALL) NOPASSWD: /usr/local/bin/argus-tool-check" > /etc/sudoers.d/argus

WORKDIR /workspace
USER argus

HEALTHCHECK CMD id argus || exit 1
