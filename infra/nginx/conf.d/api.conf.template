# ARGUS API Gateway — nginx reverse proxy
# Generated from api.conf.template by docker-entrypoint.sh at container start.
# Do NOT edit api.conf directly in the container; modify this template instead.
#
# Features:
#   - Reverse proxy to backend (http://backend:8000)
#   - Rate limiting (30 req/s per IP, burst 50)
#   - Security headers (X-Frame-Options, X-Content-Type-Options, HSTS-ready)
#   - CORS whitelist (map-based origin validation, populated from ARGUS_CORS_ALLOWED_ORIGINS)
#   - SSE support for /api/v1/scans/ (long-lived connections)
#   - Health-check endpoint for docker healthcheck
#   - Commented SSL block for production TLS termination with HSTS

# Upstreams are resolved per-request via the runtime DNS server (see the
# `resolver` + `set $upstream_* ...` directives in each server block below),
# NOT via static `upstream {}` blocks. Rationale:
#   - A recreated container (new IP after `docker compose up -d backend`) is
#     picked up automatically — no stale-IP 502/504 until an nginx reload.
#   - An absent/optional upstream (e.g. admin-frontend not started) never fails
#     `nginx -t`, so a down admin console can't take the public API gateway down
#     (previously: "host not found in upstream admin-frontend:6100").
# The resolver IP is injected by docker-entrypoint.sh from the container's own
# /etc/resolv.conf (Docker: 127.0.0.11, rootless Podman: the network gateway).

limit_req_zone $binary_remote_addr zone=api:10m rate=30r/s;
limit_req_zone $binary_remote_addr zone=auth:10m rate=5r/s;

# ── Map hash sizing ──────────────────────────────────────────────────
# Default 64-byte bucket overflows on long origins like Vercel preview URLs
# (e.g. `argus-frontend-<hash>-<org>-projects-<id>.vercel.app`). Must be
# declared here (not in default.conf) because conf.d files load in
# alphabetical order, so api.conf is parsed before default.conf.
map_hash_bucket_size 256;
map_hash_max_size    2048;

# ── CORS origin whitelist ─────────────────────────────────────────────
# Built by docker-entrypoint.sh from ARGUS_CORS_ALLOWED_ORIGINS env var.
# Non-matching origins get an empty value, which browsers treat as "denied".
map $http_origin $cors_allow_origin {
    default "";
${ARGUS_CORS_MAP_ENTRIES}
}

server {
    listen 80 default_server;
    server_name _;

    client_max_body_size 50m;

    # Per-request upstream resolution (see upstream note at top).
    resolver ${ARGUS_RESOLVER} valid=10s ipv6=off;
    set $upstream_backend "backend:8000";

    # ── Security headers ─────────────────────────────────────────────
    add_header X-Frame-Options        "SAMEORIGIN"  always;
    add_header X-Content-Type-Options "nosniff"      always;
    # X-XSS-Protection: set to "0" — the legacy "1; mode=block" filter is deprecated
    # in modern browsers (removed from Chromium, never in Firefox). "0" explicitly disables
    # the filter to avoid false-positive XSS-Auditor behavior. Use CSP instead.
    add_header X-XSS-Protection       "0" always;
    add_header Referrer-Policy        "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy     "camera=(), microphone=(), geolocation=()" always;
    add_header Content-Security-Policy "default-src 'none'; frame-ancestors 'none'" always;
    # HSTS: enable in TLS/SSL server block (see commented block below)

    # ── Logging ──────────────────────────────────────────────────────
    access_log /var/log/nginx/argus_access.log;
    error_log  /var/log/nginx/argus_error.log warn;

    # ── Auth endpoints (stricter rate limit) ─────────────────────────
    location /api/v1/auth/ {
        limit_req zone=auth burst=10 nodelay;

        add_header Access-Control-Allow-Origin  $cors_allow_origin always;
        add_header Access-Control-Allow-Methods "GET, POST, OPTIONS" always;
        add_header Access-Control-Allow-Headers "Content-Type, Authorization, X-API-Key, X-Tenant-ID, X-Admin-Key" always;
        add_header Access-Control-Max-Age       "7200" always;

        if ($request_method = OPTIONS) {
            return 204;
        }

        proxy_pass         http://$upstream_backend;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
${ARGUS_PROXY_API_KEY_HEADER}
        proxy_read_timeout 30s;
        proxy_connect_timeout 5s;
    }

    # ── SSE support for scan events (long-lived connections) ─────────
    # IMPORTANT:
    # Do NOT use `location /api/v1/scans/` here: nginx then auto-redirects
    # `/api/v1/scans` -> `/api/v1/scans/` (301), while FastAPI redirects back
    # `/api/v1/scans/` -> `/api/v1/scans` (307). Behind Vercel/Cloudflare this
    # causes a redirect loop and the browser reports `Failed to fetch`.
    # Match only the SSE endpoint shape.
    location ~ ^/api/v1/scans/[^/]+/events$ {
        limit_req zone=api burst=50 nodelay;

        add_header Access-Control-Allow-Origin  $cors_allow_origin always;
        add_header Access-Control-Allow-Methods "GET, OPTIONS" always;
        add_header Access-Control-Allow-Headers "Content-Type, Authorization, X-API-Key, X-Tenant-ID, X-Admin-Key" always;
        add_header Access-Control-Max-Age       "7200" always;

        if ($request_method = OPTIONS) {
            return 204;
        }

        proxy_pass         http://$upstream_backend;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
${ARGUS_PROXY_API_KEY_HEADER}
        proxy_set_header   Connection        '';
        proxy_http_version 1.1;
        chunked_transfer_encoding off;
        proxy_buffering    off;
        proxy_cache        off;
        proxy_read_timeout 3600s;
    }

    # ── Reports API (long-running generate/download; RPT-003/004 contract paths) ──
    # Matches GET/POST /api/v1/reports/* and /api/v1/scans/*/reports/* (generate-all).
    location ~ ^/api/v1/(reports(/.*)?|scans/[^/]+/reports(/.*)?)$ {
        limit_req zone=api burst=50 nodelay;

        add_header Access-Control-Allow-Origin  $cors_allow_origin always;
        add_header Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS" always;
        add_header Access-Control-Allow-Headers "Content-Type, Authorization, X-API-Key, X-Tenant-ID, X-Admin-Key" always;
        add_header Access-Control-Max-Age       "7200" always;

        if ($request_method = OPTIONS) {
            return 204;
        }

        proxy_pass         http://$upstream_backend;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
${ARGUS_PROXY_API_KEY_HEADER}
        proxy_read_timeout 3600s;
        proxy_connect_timeout 10s;
    }

    # ── General API proxy ────────────────────────────────────────────
    location /api/ {
        limit_req zone=api burst=50 nodelay;

        add_header Access-Control-Allow-Origin  $cors_allow_origin always;
        add_header Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS" always;
        add_header Access-Control-Allow-Headers "Content-Type, Authorization, X-API-Key, X-Tenant-ID, X-Admin-Key" always;
        add_header Access-Control-Max-Age       "7200" always;

        if ($request_method = OPTIONS) {
            return 204;
        }

        proxy_pass         http://$upstream_backend;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
${ARGUS_PROXY_API_KEY_HEADER}
        proxy_read_timeout 300s;
        proxy_connect_timeout 10s;
    }

    # ── Health check (docker healthcheck: wget http://localhost/health) ─
    location /health {
        proxy_pass http://$upstream_backend/api/v1/health;
        proxy_set_header Host $host;
    }

    # ── Default catch-all ────────────────────────────────────────────
    location / {
        return 404;
    }
}

# ── TLS termination for the Admin console (HTTPS) ────────────────────
# Terminates TLS and reverse-proxies the whole Next.js admin app
# (admin-frontend:6100): pages, server actions, static assets, and the
# built-in /api/v1/* → backend rewrite. This block is the supported entry
# point for the admin console on a public host: the backend mints the
# session cookie with Secure+HttpOnly+SameSite=Strict, which browsers only
# persist on an HTTPS origin — plain HTTP on :6100 silently drops it and the
# console falls back to "Access denied".
#
# Cert material is mounted read-only from infra/nginx/ssl (see compose).
# Generate a self-signed pair before the first start (nginx -t fails fast in
# the entrypoint if the files are missing):
#   openssl req -x509 -newkey rsa:2048 -nodes -days 825 \
#     -keyout infra/nginx/ssl/privkey.pem -out infra/nginx/ssl/fullchain.pem \
#     -subj "/CN=argus-admin" -addext "subjectAltName=IP:<public-ip>"
server {
    listen 443 ssl;
    http2 on;
    server_name _;

    client_max_body_size 50m;

    # Per-request upstream resolution (see upstream note at top).
    resolver ${ARGUS_RESOLVER} valid=10s ipv6=off;
    set $upstream_admin "admin-frontend:6100";

    ssl_certificate     /etc/nginx/ssl/fullchain.pem;
    ssl_certificate_key /etc/nginx/ssl/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 10m;
    ssl_session_tickets off;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Frame-Options        "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy        "strict-origin-when-cross-origin" always;

    access_log /var/log/nginx/argus_tls_access.log;
    error_log  /var/log/nginx/argus_tls_error.log warn;

    location / {
        proxy_pass         http://$upstream_admin;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_set_header   X-Forwarded-Host  $host;
        proxy_read_timeout 300s;
        proxy_connect_timeout 10s;
    }
}
